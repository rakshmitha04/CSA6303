            "Enter incident description: An attacker sends ransomware to a computer\n",
            "Threat Category: Malware\n"
          ]
        }
      ],
      "source": [
        "description = input(\"Enter incident description: \").lower()\n",
        "\n",
        "threats = {\n",
        "    \"Phishing\": [\"phishing\", \"fake email\", \"credential theft\"],\n",
        "    \"DoS/DDoS\": [\"ddos\", \"denial of service\", \"traffic flooding\"],\n",
        "    \"Malware\": [\"ransomware\", \"virus\", \"trojan\", \"malware\"],\n",
        "    \"Man-in-the-Middle\": [\"man-in-the-middle\", \"mitm\", \"intercept traffic\"]\n",
        "}\n",
        "\n",
        "found = False\n",
        "\n",
        "for threat, keywords in threats.items():\n",
        "    if any(word in description for word in keywords):\n",
        "        print(\"Threat Category:\", threat)\n",
        "        found = True\n",
        "        break\n",
        "\n",
        "if not found:\n",
        "    print(\"Threat Category: Unknown\")"
      ]
    }
