      "source": [
        "from collections import Counter\n",
        "\n",
        "events = [\n",
        "    {\"source\": \"Firewall\", \"ip\": \"10.0.0.5\", \"event\": \"failed_login\"},\n",
        "    {\"source\": \"Server\", \"ip\": \"10.0.0.5\", \"event\": \"failed_login\"},\n",
        "    {\"source\": \"IDS\", \"ip\": \"10.0.0.5\", \"event\": \"failed_login\"}\n",
        "]\n",
        "\n",
        "print(\"Collected Events:\", len(events))\n",
        "\n",
        "normalized = [\n",
        "    {\"source\": e[\"source\"].lower(),\n",
        "     \"ip\": e[\"ip\"],\n",
        "     \"event\": e[\"event\"].lower()}\n",
        "    for e in events\n",
        "]\n",
        "\n",
        "counts = Counter(\n",
        "    e[\"ip\"] for e in normalized\n",
        "    if e[\"event\"] == \"failed_login\"\n",
        ")\n",
        "\n",
        "for ip, count in counts.items():\n",
        "    if count >= 3:\n",
        "        print(\"ALERT: Multiple failed logins from\", ip)"
      ]
    }
  ]
