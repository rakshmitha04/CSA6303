      "source": [
        "connections = set()\n",
        "\n",
        "def firewall(kind, source, destination):\n",
        "    if kind == \"OUTBOUND\":\n",
        "        connections.add((source, destination))\n",
        "        print(\"Outbound connection ALLOWED\")\n",
        "\n",
        "    elif kind == \"RETURN\":\n",
        "        if (destination, source) in connections:\n",
        "            print(\"Return traffic ALLOWED\")\n",
        "        else:\n",
        "            print(\"Return traffic BLOCKED\")\n",
        "\n",
        "    else:\n",
        "        print(\"Unsolicited inbound traffic BLOCKED\")\n",
        "\n",
        "firewall(\"OUTBOUND\", \"PC\", \"Server\")\n",
        "firewall(\"RETURN\", \"Server\", \"PC\")\n",
        "firewall(\"RETURN\", \"Unknown\", \"PC\")"
      ]
    }
