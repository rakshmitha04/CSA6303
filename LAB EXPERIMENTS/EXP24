      "source": [
        "required = {\n",
        "    \"Firewall\": \"enabled\",\n",
        "    \"Antivirus\": \"enabled\",\n",
        "    \"MFA\": \"enabled\",\n",
        "    \"Encryption\": \"enabled\",\n",
        "    \"Automatic Updates\": \"enabled\"\n",
        "}\n",
        "\n",
        "current = {\n",
        "    \"Firewall\": \"enabled\",\n",
        "    \"Antivirus\": \"enabled\",\n",
        "    \"MFA\": \"disabled\",\n",
        "    \"Encryption\": \"disabled\",\n",
        "    \"Automatic Updates\": \"enabled\"\n",
        "}\n",
        "\n",
        "print(\"Security Baseline Assessment\")\n",
        "\n",
        "for control, baseline in required.items():\n",
        "    if current.get(control, \"missing\") == baseline:\n",
        "        print(control, \": PASS\")\n",
        "    else:\n",
        "        print(control, \": FAIL\")"
      ]
    }
