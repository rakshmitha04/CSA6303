        "logs = [\n",
        "    (\"alice\", \"FAIL\"),\n",
        "    (\"alice\", \"FAIL\"),\n",
        "    (\"alice\", \"FAIL\"),\n",
        "    (\"alice\", \"SUCCESS\"),\n",
        "    (\"bob\", \"FAIL\")\n",
        "]\n",
        "\n",
        "username = input(\"Enter username to check: \")\n",
        "failed_count = 0\n",
        "detected = False\n",
        "\n",
        "for user, status in logs:\n",
        "    if user == username:\n",
        "        if status == \"FAIL\":\n",
        "            failed_count += 1\n",
        "        elif status == \"SUCCESS\":\n",
        "            if failed_count >= 3:\n",
        "                detected = True\n",
        "            failed_count = 0\n",
        "\n",
        "if detected:\n",
        "    print(\"Alert: Possible brute-force attack detected!\")\n",
        "else:\n",
        "    print(\"No brute-force pattern detected.\")"
      ]
