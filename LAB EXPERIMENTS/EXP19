      "source": [
        "from collections import Counter\n",
        "\n",
        "events = [\n",
        "    {\"user\": \"Alice\", \"status\": \"success\"},\n",
        "    {\"user\": \"Bob\", \"status\": \"failed\"},\n",
        "    {\"user\": \"Bob\", \"status\": \"failed\"},\n",
        "    {\"user\": \"Alice\", \"status\": \"success\"}\n",
        "]\n",
        "\n",
        "print(\"Search Results: Failed Events\")\n",
        "\n",
        "for event in events:\n",
        "    if event[\"status\"] == \"failed\":\n",
        "        print(event)\n",
        "\n",
        "print(\"\\nStats Count by User:\")\n",
        "\n",
        "counts = Counter(e[\"user\"] for e in events)\n",
        "\n",
        "for user, count in counts.items():\n",
        "    print(user, \":\", count)"
      ]
    }
