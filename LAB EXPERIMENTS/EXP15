            "Describe security control: Encryption protects stored information\n",
            "Control Theme: Technological\n"
          ]
        }
      ],
      "source": [
        "control = input(\"Describe security control: \").lower()\n",
        "\n",
        "domains = {\n",
        "    \"Organizational\": [\"policy\", \"risk management\", \"supplier\"],\n",
        "    \"People\": [\"employee\", \"training\", \"awareness\"],\n",
        "    \"Physical\": [\"door\", \"cctv\", \"building\"],\n",
        "    \"Technological\": [\"firewall\", \"encryption\", \"antivirus\"]\n",
        "}\n",
        "\n",
        "found = False\n",
        "\n",
        "for domain, keywords in domains.items():\n",
        "    if any(word in control for word in keywords):\n",
        "        print(\"Control Theme:\", domain)\n",
        "        found = True\n",
        "        break\n",
        "\n",
        "if not found:\n",
        "    print(\"Control Theme: Unknown\")"
      ]
    }
