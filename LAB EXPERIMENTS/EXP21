          "text": [
            "Enter post-incident report: The system lacked security patches and monitoring alerts. Backup recovery also failed.\n",
            "\n",
            "Improvement Areas Identified:\n",
            "- Patch Management\n",
            "- Monitoring\n",
            "- Backup Strategy\n"
          ]
        }
      ],
      "source": [
        "report = input(\"Enter post-incident report: \").lower()\n",
        "\n",
        "areas = {\n",
        "    \"Patch Management\": [\"patch\", \"update\", \"vulnerability\"],\n",
        "    \"Security Awareness\": [\"training\", \"awareness\", \"phishing\"],\n",
        "    \"Monitoring\": [\"monitoring\", \"logs\", \"alert\"],\n",
        "    \"Backup Strategy\": [\"backup\", \"recovery\", \"restore\"],\n",
        "    \"Access Control\": [\"permissions\", \"access control\", \"unauthorized access\"]\n",
        "}\n",
        "\n",
        "print(\"\\nImprovement Areas Identified:\")\n",
        "\n",
        "found = False\n",
        "\n",
        "for area, keywords in areas.items():\n",
        "    if any(word in report for word in keywords):\n",
        "        print(\"-\", area)\n",
        "        found = True\n",
        "\n",
        "if not found:\n",
        "    print(\"No improvement areas identified.\")"
      ]
    }
  ]
