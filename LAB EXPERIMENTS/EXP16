      "source": [
        "layers = {\n",
        "    \"Firewall\": True,\n",
        "    \"IDS\": False,\n",
        "    \"Antivirus\": True,\n",
        "    \"Access Control\": True\n",
        "}\n",
        "\n",
        "blocked = False\n",
        "\n",
        "for layer, detects_attack in layers.items():\n",
        "    if blocked:\n",
        "        print(layer, \": Attack already blocked\")\n",
        "    elif detects_attack:\n",
        "        print(layer, \": Attack blocked\")\n",
        "        blocked = True\n",
        "    else:\n",
        "        print(layer, \": Attack passed\")\n",
        "\n",
        "print(\"Final Result:\", \"Protected\" if blocked else \"Attack succeeded\")"
      ]
